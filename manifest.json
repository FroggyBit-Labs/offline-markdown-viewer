{
  "manifest_version": 3,
  "name": "Offline Markdown Viewer",
  "version": "0.2.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "FroggyBit Labs",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.markdown",
        "file:///*.mdown"
      ],
      "js": [
        "vendor/purify.min.js",
        "vendor/marked.umd.js",
        "vendor/mermaid.min.js",
        "src/i18n.js",
        "src/render.js",
        "src/content.js"
      ],
      "css": [
        "src/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
  }
}

