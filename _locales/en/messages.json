  "net_title": {
    "message": "Remote images"
  },
  "net_intro": {
    "message": "Remote images are blocked by default. If you allow some sites, images from those sites can load. Those sites will see your IP address and when you open a document. The extension sends nothing else."
  },
  "net_enable_label": {
    "message": "Allow remote images from the sites listed below"
  },
  "net_allow_label": {
    "message": "Allowed sites (one per line)"
  },
  "net_allow_hint": {
    "message": "Examples: https://example.org · https://*.example.org · https://example.org/images/ · http://192.168.1.10:8080 · \\\\nas01\\photos\\ (network folder). Only http://, https:// and \\\\server\\ addresses are accepted. A * is allowed only at the start of a web host name. Anything not listed stays blocked."
  },
  "net_consent": {
    "message": "I understand that the listed sites will see my IP address and when I open documents."
  },
  "net_consent_unc": {
    "message": "I understand that Windows may send my sign-in details to the listed network servers, so I only list servers I trust."
  },
  "net_need_consent_unc": {
    "message": "Tick the second box: network folders can receive your Windows sign-in details."
  },
  "net_apply": {
    "message": "Apply and reload"
  },
  "net_need_site": {
    "message": "Add at least one site, or turn the option off."
  },
  "net_need_consent": {
    "message": "Tick the box to confirm you understand."
  },
